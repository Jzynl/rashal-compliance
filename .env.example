# Copy to .env and edit. Never commit .env.

SECRET_KEY=change-this-to-something-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_BASE_URL=http://127.0.0.1:8000

# --- Database ---------------------------------------------------------
# sqlite runs with zero setup. Switch to postgres for real use.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=rashal_compliance
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Branding ---------------------------------------------------------
COMPANY_NAME=Rashal Energies
COMPANY_TAGLINE=Igniting Africa

# --- Email ------------------------------------------------------------
# Left blank in DEBUG: mail prints to the console.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=compliance@rashal.co.tz

# --- SMS (Beem Africa) ------------------------------------------------
# Keep SMS_BACKEND=log everywhere except production. "log" writes the
# message to the console so nobody is woken at 3am by a test run.
SMS_BACKEND=log
# SMS_BACKEND=beem
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=RASHAL
SMS_DEFAULT_COUNTRY_CODE=255
